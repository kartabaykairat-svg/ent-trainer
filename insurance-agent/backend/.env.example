# Copy to .env and fill in real values before running in anything but local dev.

# --- Auth / security --------------------------------------------------------
# Random 32+ byte secret used to sign session JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-before-deploying
# Fernet key used to encrypt PII columns at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-before-deploying
# Minutes of inactivity before a manager session expires (auto-logout).
SESSION_TIMEOUT_MINUTES=20

# Seed manager account, created on first startup if the managers table is
# empty. Change the password immediately in a real deployment.
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=change-me-please

# --- Storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./storage/app.db
STORAGE_DIR=./storage
# If true, uploaded source documents are deleted as soon as the client's
# data has been confirmed and the contract/POA are generated.
DELETE_SOURCE_DOCS_AFTER_GENERATION=false
MAX_UPLOAD_MB=15

# --- OCR ----------------------------------------------------------------------
# Path to the tesseract binary if it is not on PATH.
TESSERACT_CMD=

# --- Optional LLM-assisted structured extraction ------------------------------
# When unset, the app relies solely on the deterministic OCR+regex extractor
# (app/services/extraction.py) - it never invents data either way, but the
# LLM pass can improve field segmentation on noisy scans when a key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- CORS ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
